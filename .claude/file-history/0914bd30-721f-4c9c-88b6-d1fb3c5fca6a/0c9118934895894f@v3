extends CanvasLayer

var score_label: Label
var distance_label: Label
var hearts_label: Label
var power_up_label: Label

func _ready() -> void:
	GameManager.score_changed.connect(_on_score_changed)

	score_label = Label.new()
	score_label.anchor_top = 0.0
	score_label.anchor_right = 1.0
	score_label.offset_left = 10
	score_label.offset_top = 10
	score_label.offset_right = -10
	score_label.offset_bottom = 40
	score_label.add_theme_font_size_override("font_size", 28)
	add_child(score_label)

	distance_label = Label.new()
	distance_label.anchor_top = 0.0
	distance_label.anchor_right = 1.0
	distance_label.offset_left = 10
	distance_label.offset_top = 40
	distance_label.offset_right = -10
	distance_label.offset_bottom = 64
	distance_label.add_theme_font_size_override("font_size", 16)
	add_child(distance_label)

	hearts_label = Label.new()
	hearts_label.anchor_top = 0.0
	hearts_label.anchor_left = 1.0
	hearts_label.offset_left = -120
	hearts_label.offset_top = 10
	hearts_label.offset_right = -10
	hearts_label.offset_bottom = 40
	hearts_label.add_theme_font_size_override("font_size", 24)
	add_child(hearts_label)

	power_up_label = Label.new()
	power_up_label.anchor_top = 0.0
	power_up_label.anchor_left = 1.0
	power_up_label.offset_left = -160
	power_up_label.offset_top = 40
	power_up_label.offset_right = -10
	power_up_label.offset_bottom = 64
	power_up_label.add_theme_font_size_override("font_size", 14)
	add_child(power_up_label)

func _process(_delta: float) -> void:
	if GameManager.state != GameManager.State.PLAY:
		return
	score_label.text = str(int(GameManager.score))
	distance_label.text = str(int(GameManager.total_distance)) + "m"

	var player := get_tree().get_first_node_in_group("player")
	if player:
		var hp_text := ""
		for i in range(player.max_hp):
			hp_text += "❤ " if i < player.hp else "♡ "
		hearts_label.text = hp_text

		var pu_text := ""
		if player.magnet_active:
			pu_text += "Magnet %.1fs  " % player.magnet_timer
		if player.double_coin_active:
			pu_text += "x2 %.1fs  " % player.double_coin_timer
		if player.skate_active:
			pu_text += "Skate %.1fs" % player.skate_timer
		power_up_label.text = pu_text

func _on_score_changed(new_score: float) -> void:
	score_label.text = str(int(new_score))
