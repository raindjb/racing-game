extends Node2D

@export var train_color: Color = Color.RED
@export var num_cars: int = 3
@export var train_width: int = 1
@export var lane: int = 0
@export var climbable: bool = false

var depth: float = 0.02
var horn_timer: float = 0.0
var graffiti_count: int = 0

func _ready() -> void:
	horn_timer = randf_range(1.5, 3.0)
	graffiti_count = randi_range(0, 2)
	queue_redraw()

func _process(delta: float) -> void:
	if GameManager.state != GameManager.State.PLAY:
		return

	depth += GameManager.current_speed * delta / (get_viewport().get_visible_rect().size.y * 0.75)

	horn_timer -= delta
	if horn_timer <= 0 and depth > 0.08 and depth < 0.75:
		horn_timer = randf_range(2.0, 4.0)

	if depth > 1.12:
		queue_free()
		return

	_update_position()
	queue_redraw()

func _update_position() -> void:
	var pos := Perspective.depth_to_position(float(lane), depth)
	position = Vector2(pos.x, pos.y)
	scale = Vector2(pos.scale, pos.scale)

func covers_lane(player_lane: float) -> bool:
	if train_width == 2:
		return player_lane >= float(lane) - 0.3 and player_lane <= float(lane) + 1.3
	return absf(player_lane - float(lane)) < 0.45

func _draw() -> void:
	var u: float = get_viewport().get_visible_rect().size.x * 0.028
	var total_w := float(train_width) * u * 10

	for c in range(num_cars):
		var cz := float(c) * u * 4.8
		draw_rect(Rect2(cz - total_w / 2 + u * 0.5, -u * 4, u * 4.3, u * 5), train_color)
		draw_rect(Rect2(cz - total_w / 2 + u * 0.5, -u * 4.5, u * 4.3, u * 0.5), Color("#555"))
		draw_circle(Vector2(cz - total_w / 2 + u * 1.5, u * 1.2), u * 0.7, Color.BLACK)
		draw_circle(Vector2(cz - total_w / 2 + u * 3.5, u * 1.2), u * 0.7, Color.BLACK)

	var hx := -(total_w / 2 - u * 0.3)
	draw_rect(Rect2(hx - u * 2, -u * 4.8, u * 5, u * 5.8), train_color)
	draw_rect(Rect2(hx - u * 1.2, -u * 4, u * 3, u * 2.5), Color("#87CEEB"))
	draw_circle(Vector2(hx + u * 2, -u * 2), u, Color.YELLOW)
	draw_rect(Rect2(hx - u * 0.5, -u * 6.5, u * 1.5, u * 2), Color("#333"))

	if climbable:
		draw_rect(Rect2(-total_w / 2 + u * 0.5, -u * 5, u * 2, u * 4), Color(0.18, 0.80, 0.44, 0.5))

	if train_width == 2:
		draw_rect(Rect2(-total_w / 2, -u * 5, total_w, u), Color(1, 1, 0, 0.3))
