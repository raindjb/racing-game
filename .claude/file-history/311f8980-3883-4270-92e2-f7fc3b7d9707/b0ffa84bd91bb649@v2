// ============================================================
// 输入处理
// ============================================================
function handleInput(action) {
  if (gameState === STATE.MENU) {
    if (action === 'start' || action === 'jump' || action === 'slide') {
      startGame();
    }
    return;
  }
  if (gameState === STATE.DEAD) {
    if (action === 'start' || action === 'jump' || action === 'slide') {
      startGame();
    }
    return;
  }
  if (gameState !== STATE.PLAYING) return;

  switch (action) {
    case 'left':
      PLAYER.targetLane = Math.max(-1, PLAYER.targetLane - 1);
      break;
    case 'right':
      PLAYER.targetLane = Math.min(1, PLAYER.targetLane + 1);
      break;
    case 'jump':
      if (!PLAYER.isJumping && !PLAYER.isSliding) {
        PLAYER.isJumping = true;
        PLAYER.vy = -9;
        PLAYER.jumpHeight = 0;
        sfxJump();
      }
      break;
    case 'slide':
      if (!PLAYER.isJumping && !PLAYER.isSliding) {
        PLAYER.isSliding = true;
        PLAYER.slideTimer = 0.55;
        sfxSlide();
      }
      break;
  }
}

// 键盘
const keys = {};
window.addEventListener('keydown', e => {
  if (keys[e.code]) return;
  keys[e.code] = true;
  switch (e.code) {
    case 'ArrowLeft': case 'KeyA': handleInput('left'); break;
    case 'ArrowRight': case 'KeyD': handleInput('right'); break;
    case 'ArrowUp': case 'KeyW': handleInput('jump'); break;
    case 'ArrowDown': case 'KeyS': handleInput('slide'); break;
    case 'Space': handleInput('start'); break;
  }
  e.preventDefault();
});
window.addEventListener('keyup', e => { keys[e.code] = false; });

// 触屏
let touchStartX = 0, touchStartY = 0, touchStartTime = 0;
window.addEventListener('touchstart', e => {
  const t = e.touches[0];
  touchStartX = t.clientX;
  touchStartY = t.clientY;
  touchStartTime = Date.now();
});
window.addEventListener('touchend', e => {
  const t = e.changedTouches[0];
  const dx = t.clientX - touchStartX;
  const dy = t.clientY - touchStartY;
  const dt = Date.now() - touchStartTime;

  if (Math.abs(dx) < 10 && Math.abs(dy) < 10 && dt < 300) {
    // Tap
    handleInput('start');
    return;
  }
  if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 30) {
    handleInput(dx > 0 ? 'right' : 'left');
  } else if (Math.abs(dy) > 30) {
    handleInput(dy < 0 ? 'jump' : 'slide');
  }
});

// 点击(PC)
canvas.addEventListener('click', e => {
  if (gameState !== STATE.PLAYING) {
    handleInput('start');
  }
});

// ============================================================
// 游戏更新
// ============================================================
function update(dt) {
  if (gameState !== STATE.PLAYING) return;
  if (slowMotion > 0) {
    dt *= 0.3;
    slowMotion -= dt;
  }

  // 限制最大步长
  dt = Math.min(dt, 0.1);
  frameCount++;

  // ---- 速度 & 坡度 ----
  slopeTimer -= dt;
  if (slopeTimer <= 0) {
    targetSlope = rand(-0.6, 0.6);
    slopeTimer = rand(3, 7);
  }
  slopeValue = lerp(slopeValue, targetSlope, dt * 0.5);
  // 速度随距离逐渐增加(0-30%加速)
  const speedRamp = 1 + Math.min(totalDistanceTraveled / 15000, 1) * 0.3;
  speed = 250 * speedRamp;
  currentSpeed = speed * (1 - slopeValue * 0.25); // 上坡慢，下坡快
  currentSpeed = Math.max(150, Math.min(450, currentSpeed));

  // ---- 距离 & 分数 ----
  const distDelta = currentSpeed * dt;
  totalDistanceTraveled += distDelta;
  distance += distDelta;
  score += distDelta * 0.5;
  trackOffset += distDelta * 0.8;
  sceneOffset += distDelta * 0.3;

  // 每500米回血
  if (totalDistanceTraveled - lastHealDistance >= 500) {
    lastHealDistance = Math.floor(totalDistanceTraveled / 500) * 500;
    if (PLAYER.hp < PLAYER.maxHp) {
      PLAYER.hp = Math.min(PLAYER.maxHp, PLAYER.hp + 1);
      sfxHeal();
      spawnParticles(W() / 2, H() * PLAYER.y, 12, '#e74c3c');
    }
  }

  // ---- 跑道切换平滑过渡 ----
  PLAYER.lane = PLAYER.targetLane;
  PLAYER.currentLaneX = lerp(PLAYER.currentLaneX, PLAYER.lane, dt * 10);

  // ---- 跳跃 ----
  if (PLAYER.isJumping) {
    PLAYER.jumpHeight += PLAYER.vy * dt;
    PLAYER.vy += 25 * dt; // 重力
    if (PLAYER.jumpHeight >= 0) {
      PLAYER.jumpHeight = 0;
      PLAYER.vy = 0;
      PLAYER.isJumping = false;
    }
  }

  // ---- 滑铲 ----
  if (PLAYER.isSliding) {
    PLAYER.slideTimer -= dt;
    if (PLAYER.slideTimer <= 0) {
      PLAYER.isSliding = false;
    }
  }

  // ---- 无敌时间 ----
  if (PLAYER.invincible > 0) PLAYER.invincible -= dt;

  // ---- 道具计时器 ----
  if (PLAYER.magnetTimer > 0) { PLAYER.magnetTimer -= dt; if (PLAYER.magnetTimer <= 0) PLAYER.magnetActive = false; }
  if (PLAYER.doubleCoinTimer > 0) { PLAYER.doubleCoinTimer -= dt; if (PLAYER.doubleCoinTimer <= 0) PLAYER.doubleCoin = false; }
  if (PLAYER.skateboardTimer > 0) { PLAYER.skateboardTimer -= dt; if (PLAYER.skateboardTimer <= 0) PLAYER.skateboard = false; }

  // ---- 火车顶跟随 ----
  if (PLAYER.onTrain) {
    PLAYER.trainRideX += currentSpeed * dt * 0.8;
    // 检查火车是否快出屏幕
    const t = PLAYER.onTrain;
    if (t.screenY > H() * 0.85) {
      // 强制跳回轨道
      PLAYER.onTrain = null;
      PLAYER.isJumping = true;
      PLAYER.vy = -8;
      PLAYER.jumpHeight = -H() * 0.02;
    }
  }

  // ---- 更新障碍物 ----
  for (let i = obstacles.length - 1; i >= 0; i--) {
    const o = obstacles[i];
    const pw = PERSPECTIVE;
    o.worldY += currentSpeed * dt / (H() * 0.8); // 向玩家移动
    o.screenY = H() * pw.vanishY + o.worldY * (H() * pw.groundBase - H() * pw.vanishY);

    // 移除出屏的
    if (o.worldY > 1.1) {
      if (!o.passed) {
        // 安全通过，加分
        score += 10;
      }
      obstacles.splice(i, 1);
      continue;
    }

    // 碰撞检测: 障碍物到达玩家所在深度区域
    if (!o.passed && o.worldY > 0.68 && o.worldY < 0.86) {
      // 检查是否在同一跑道(带容差)
      const laneDist = Math.abs(PLAYER.currentLaneX - o.lane);
      if (laneDist < 0.55) {
        let hit = true;

        // 跳跃可越过 action=1 (中等高度)障碍
        if (o.action === 1 && PLAYER.isJumping && PLAYER.jumpHeight < -H() * 0.025) {
          hit = false;
        }
        // 滑铲可越过 action=0 (低矮)障碍
        if (o.action === 0 && PLAYER.isSliding) {
          hit = false;
        }
        // 高障碍(action=2)在非相同跑道时不碰撞
        if (o.action === 2 && laneDist > 0.35) {
          hit = false;
        }

        if (hit && PLAYER.invincible <= 0 && PLAYER.onTrain === null) {
          // 碰到! 扣血
          if (PLAYER.skateboard) {
            PLAYER.skateboard = false;
            PLAYER.skateboardTimer = 0;
            spawnParticles(W() / 2, H() * PLAYER.y, 15, '#2ecc71');
          } else {
            PLAYER.hp--;
            PLAYER.invincible = 1.5;
            sfxHit();
            shakeIntensity = 5;
            shakeTimer = 0.3;
            spawnParticles(W() / 2, H() * PLAYER.y, 10, '#ff0000');
            if (PLAYER.hp <= 0) {
              gameOver();
              return;
            }
          }
          o.passed = true; // 碰到后标记，避免一帧内多次碰撞
        }
        // 安全通过标记
        if (!hit && o.worldY > 0.78) o.passed = true;
      }
    }
  }

  // ---- 更新道具 ----
  for (let i = powerups.length - 1; i >= 0; i--) {
    const p = powerups[i];
    const pw = PERSPECTIVE;
    p.worldY += currentSpeed * dt / (H() * 0.8);
    p.screenY = H() * pw.vanishY + p.worldY * (H() * pw.groundBase - H() * pw.vanishY);
    p.rotation += dt * 3;

    // 磁铁吸引
    if (PLAYER.magnetActive && p.worldY > 0.4 && p.worldY < 0.85) {
      const playerLane = PLAYER.currentLaneX;
      p.lane = lerp(p.lane, playerLane, dt * 2);
    }

    if (p.worldY > 1.05) {
      powerups.splice(i, 1);
      continue;
    }

    // 收集检测(扩大敏感区域)
    if (p.worldY > 0.62 && p.worldY < 0.9 && Math.abs(PLAYER.currentLaneX - p.lane) < 0.6) {
      collectPowerup(p);
      powerups.splice(i, 1);
    }
  }

  // ---- 更新火车 ----
  for (let i = trains.length - 1; i >= 0; i--) {
    const t = trains[i];
    const pw = PERSPECTIVE;
    t.worldY += currentSpeed * dt / (H() * 0.8);
    t.screenY = H() * pw.vanishY + t.worldY * (H() * pw.groundBase - H() * pw.vanishY);
    t.lightTimer += dt;
    t.lightOn = Math.sin(t.lightTimer * 5) > 0;
    t.hornTimer -= dt;
    if (t.hornTimer <= 0 && t.worldY > 0.1 && t.worldY < 0.8) {
      sfxTrainHorn();
      t.hornTimer = rand(2, 4);
    }

    if (t.worldY > 1.15) {
      if (PLAYER.onTrain === t) PLAYER.onTrain = null;
      trains.splice(i, 1);
      continue;
    }

    // 火车碰撞检测
    if (t.worldY > 0.66 && t.worldY < 0.88) {
      const trainLaneDist = Math.abs(PLAYER.currentLaneX - t.lane);
      if (trainLaneDist < 0.5 && PLAYER.onTrain !== t && PLAYER.invincible <= 0) {
        // 可攀爬火车: 从高架坡道跳上火车顶(需要正在跳跃且坡道够高)
        if (t.climbable && PLAYER.isJumping && PLAYER.jumpHeight < -H() * 0.03 && slopeValue > 0.15) {
          PLAYER.onTrain = t;
          PLAYER.isJumping = false;
          PLAYER.jumpHeight = 0;
          PLAYER.vy = 0;
          PLAYER.trainRideX = 0;
          spawnParticles(W() / 2, H() * PLAYER.y, 8, '#f1c40f');
        } else if (!PLAYER.isJumping || (PLAYER.isJumping && PLAYER.jumpHeight > -H() * 0.02)) {
          // 被撞! (没跳起来或跳得不够高)
          if (PLAYER.skateboard) {
            PLAYER.skateboard = false;
            PLAYER.skateboardTimer = 0;
            spawnParticles(W() / 2, H() * PLAYER.y, 20, '#2ecc71');
          } else {
            PLAYER.hp -= 2;
            PLAYER.invincible = 1.5;
            sfxHit();
            shakeIntensity = 10;
            shakeTimer = 0.5;
            spawnParticles(W() / 2, H() * PLAYER.y, 15, '#ff0000');
            if (PLAYER.hp <= 0) {
              gameOver();
              return;
            }
          }
        }
      }
    }
  }

  // ---- 更新粒子 ----
  for (let i = particles.length - 1; i >= 0; i--) {
    const p = particles[i];
    p.x += p.vx;
    p.y += p.vy;
    p.vy += 0.2; // 重力
    p.life -= dt;
    if (p.life <= 0) particles.splice(i, 1);
  }

  // ---- 抖动衰减 ----
  if (shakeTimer > 0) shakeTimer -= dt;
  else shakeIntensity = 0;

  // ---- 生成障碍物 ----
  spawnTimer -= dt;
  if (spawnTimer <= 0) {
    spawnObstacle();
    spawnTimer = rand(1.0, 2.5) * (1 + totalDistanceTraveled / 5000);
    spawnTimer = Math.max(0.6, spawnTimer);
  }

  // ---- 生成道具 ----
  powerupSpawnTimer -= dt;
  if (powerupSpawnTimer <= 0) {
    spawnPowerup();
    powerupSpawnTimer = rand(1.5, 4);
    // 偶尔生成多排
    if (Math.random() < 0.25) {
      setTimeout(() => { if (gameState === STATE.PLAYING) spawnPowerup(); }, 200);
    }
  }

  // ---- 生成火车 ----
  trainSpawnTimer -= dt;
  if (trainSpawnTimer <= 0) {
    spawnTrain();
    nextTrainTime = rand(6, 12) * (1 - Math.min(totalDistanceTraveled / 15000, 0.5));
    trainSpawnTimer = nextTrainTime;
  }
}

function collectPowerup(p) {
  sfxCoin();
  switch (p.effect) {
    case 'coin':
      score += PLAYER.doubleCoin ? 100 : 50;
      spawnParticles(W() / 2, H() * PLAYER.y, 4, '#f1c40f', 1);
      break;
    case 'heal':
      PLAYER.hp = PLAYER.maxHp;
      sfxHeal();
      spawnParticles(W() / 2, H() * PLAYER.y, 15, '#e74c3c', 2);
      break;
    case 'magnet':
      PLAYER.magnetActive = true;
      PLAYER.magnetTimer = 5;
      sfxPowerup();
      break;
    case 'doubleCoin':
      PLAYER.doubleCoin = true;
      PLAYER.doubleCoinTimer = 8;
      sfxPowerup();
      break;
    case 'skateboard':
      PLAYER.skateboard = true;
      PLAYER.skateboardTimer = 30;
      sfxPowerup();
      break;
  }
  score += 5;
}

// ============================================================
// 主渲染
// ============================================================
function render() {
  ctx.clearRect(0, 0, W(), H());

  // 屏幕抖动
  let shakeX = 0, shakeY = 0;
  if (shakeTimer > 0) {
    shakeX = (Math.random() - 0.5) * shakeIntensity * 2;
    shakeY = (Math.random() - 0.5) * shakeIntensity * 2;
  }
  ctx.save();
  ctx.translate(shakeX, shakeY);

  if (gameState === STATE.MENU) {
    drawMenu();
    ctx.restore();
    return;
  }

  // ---- 场景渲染(从远到近) ----
  drawSky();
  drawCitySkyline();
  drawTerrain();

  // ---- 远处物体排序(按Y深度) ----
  const allObjects = [];

  for (const o of obstacles) {
    if (o.worldY > 0.0 && o.worldY < 1.05) {
      allObjects.push({ type: 'obstacle', obj: o, y: o.screenY });
    }
  }
  for (const p of powerups) {
    if (p.worldY > 0.0 && p.worldY < 1.05) {
      allObjects.push({ type: 'powerup', obj: p, y: p.screenY });
    }
  }
  for (const t of trains) {
    if (t.worldY > 0.0 && t.worldY < 1.15) {
      allObjects.push({ type: 'train', obj: t, y: t.screenY });
    }
  }
  // 排序: 远处(Y小)先画
  allObjects.sort((a, b) => a.y - b.y);

  // ---- 确定玩家屏幕位置 ----
  const pw = PERSPECTIVE;
  let playerSy = H() * PLAYER.y + PLAYER.jumpHeight * H() * 0.12;
  // 如果在火车上
  if (PLAYER.onTrain) {
    playerSy = PLAYER.onTrain.screenY - H() * 0.01;
  }
  const playerLaneW = W() * 0.12 * pw.scaleAt(playerSy) * 3;
  const playerSx = W() * 0.5 + PLAYER.currentLaneX * playerLaneW;
  const playerSc = pw.scaleAt(playerSy);

  // ---- 绘制物体(在玩家后面的先画) ----
  let playerDrawn = false;
  for (const obj of allObjects) {
    if (!playerDrawn && obj.y > playerSy) {
      // 在玩家后面绘制玩家
      let state = 'run';
      if (PLAYER.isSliding) state = 'slide';
      else if (PLAYER.isJumping) state = 'jump';
      else if (PLAYER.invincible > 0 && Math.floor(PLAYER.invincible * 10) % 2 === 0) state = 'hit';
      drawCharacter(playerSx, playerSy, playerSc, state);
      playerDrawn = true;
    }

    switch (obj.type) {
      case 'obstacle': drawObstacle(obj.obj); break;
      case 'powerup': drawPowerup(obj.obj); break;
      case 'train': drawTrain(obj.obj); break;
    }
  }
  if (!playerDrawn) {
    let state = 'run';
    if (PLAYER.isSliding) state = 'slide';
    else if (PLAYER.isJumping) state = 'jump';
    else if (PLAYER.invincible > 0 && Math.floor(PLAYER.invincible * 10) % 2 === 0) state = 'hit';
    drawCharacter(playerSx, playerSy, playerSc, state);
  }

  // ---- 粒子 ----
  drawParticles();

  // ---- HUD ----
  drawHUD();

  ctx.restore();

  // ---- 死亡面板 ----
  if (gameState === STATE.DEAD) {
    drawDeathPanel();
  }
}

// ============================================================
// 游戏循环
// ============================================================
let lastTime = 0;
function gameLoop(timestamp) {
  const dt = lastTime ? (timestamp - lastTime) / 1000 : 0.016;
  lastTime = timestamp;

  update(dt);
  render();
  requestAnimationFrame(gameLoop);
}

// ---- 启动 ----
resize();
generateScenery();
lastTime = performance.now();
requestAnimationFrame(gameLoop);

