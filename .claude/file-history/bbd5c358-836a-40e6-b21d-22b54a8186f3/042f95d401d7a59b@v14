<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>轨道跑者 — Rail Runner</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  html, body { width:100%; height:100%; overflow:hidden; background:#1a1a2e; }
  body {
    display:flex; justify-content:center; align-items:center;
    font-family:'Segoe UI','PingFang SC',sans-serif;
  }
  #game-container {
    position:relative;
    width:100vmin; max-width:600px;
    height:100vmin; max-height:900px;
    aspect-ratio:2/3;
  }
  canvas {
    display:block; width:100%; height:100%;
    touch-action:manipulation;
    image-rendering:auto;
  }
</style>
</head>
<body>

<div id="game-container">
  <canvas id="game"></canvas>
</div>

<script>
/* ==========================================================================
   轨道跑者 — Rail Runner  v0.1 Tier 1
   2.5D 等距视角无限跑酷 | HTML5 Canvas | 60fps | 零依赖
   ========================================================================== */

/* =========================== 命名空间 =========================== */
const G = {
  canvas: null,
  ctx: null,
  W: 0, H: 0,

  /* 游戏状态 */
  state: 'start',     // start | playing | dead
  score: 0,
  highScore: 0,
  coinScore: 0,         // 累计金币分数（防止被距离分覆盖）
  distance: 0,
  speed: 0,
  hearts: 3,
  invincible: 0,       // 剩余无敌帧数

  /* 玩家 */
  player: null,

  /* 对象池 */
  obstacles: [],
  coins: [],
  particles: [],
  powerups: [],

  /* 输入 */
  keys: {},
  swipeStart: null,
  lastSwipe: '',

  /* 屏幕震动 */
  shakeX: 0,
  shakeY: 0,
  shakeDuration: 0,
  flashAlpha: 0,

  /* 世界参数 */
  vanishY: 0,          // 消失点 Y
  vanishX: 0,          // 消失点 X
  maxDist: 1200,        // 最大可视距离
  laneSpread: 0,       // 轨道底部扩散宽度
  groundY: 0,          // 玩家地面位置 Y（屏幕坐标）

  /* 生成控制 */
  spawnTimer: 0,
  spawnInterval: 60,   // 初始帧间隔
  coinTimer: 0,
  laneCooldown: 0,     // 换道冷却帧数

  /* 帧率 */
  lastTime: 0,
  deltaTime: 0,
  fps: 0,
  frameCount: 0,
  fpsFrameCount: 0,
  fpsTime: 0,

  /* 离线画布 */
  offscreen: {},

  /* 音效 */
  audioCtx: null,
  audioReady: false,
};

/* =========================== 常量 =========================== */
const LANE_COUNT = 3;
const PLAYER_LANE = 1;     // 玩家初始在中间轨道 (0=左, 1=中, 2=右)
const MAX_HEARTS = 3;
const INVINCIBLE_FRAMES = 90;  // 1.5秒 @ 60fps
const BASE_SPEED = 1.2;
const MAX_SPEED = 3;
const SPEED_INC = 0.00025;      // 每帧加速量（更平缓）
const DISTANCE_PER_FRAME = 0.6; // 每帧距离增量（米）
const COIN_SCORE = 50;
const DISTANCE_SCORE = 1;       // 每米分数

/* 玩家动作状态 */
const STATE_RUN = 'run';
const STATE_JUMP = 'jump';
const STATE_SLIDE = 'slide';
const STATE_HIT = 'hit';

/* 障碍物类型 */
const OBS_LOW = 'low';       // 滑铲通过
const OBS_MID = 'mid';       // 跳跃通过
const OBS_HIGH = 'high';     // 必须换道

/* 道具类型 */
const PUP_MAGNET = 'magnet';   // 磁铁：自动吸金币
const PUP_SHIELD = 'shield';   // 护盾：额外承受一次伤害
const PUP_2X = '2x';           // 双倍分数

const POWERUP_DURATION = 480;  // 道具持续时间 8秒 @ 60fps
const MAGNET_RANGE = 1.5;      // 磁铁吸金币范围（轨道单位）

/* =========================== 工具函数 =========================== */
function lerp(a, b, t) { return a + (b - a) * t; }
function clamp(v, lo, hi) { return v < lo ? lo : v > hi ? hi : v; }
function randInt(min, max) { return Math.floor(Math.random() * (max - min + 1)) + min; }
function randChoice(arr) { return arr[Math.floor(Math.random() * arr.length)]; }

/* =========================== Web Audio 音效系统 =========================== */
/** 初始化 AudioContext（需在首次用户交互后调用） */
function initAudio() {
  if (G.audioReady) return;
  try {
    G.audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    G.audioReady = true;
  } catch(e) {
    G.audioReady = false;
  }
}

/** 播放一个简单的合成音效 */
function playSound(freq, type, duration, vol, options) {
  if (!G.audioReady) return;
  const ctx = G.audioCtx;
  const opts = options || {};
  const now = ctx.currentTime;

  const osc = ctx.createOscillator();
  const gain = ctx.createGain();
  osc.type = type || 'sine';
  osc.frequency.setValueAtTime(freq, now);
  if (opts.freqEnd) osc.frequency.linearRampToValueAtTime(opts.freqEnd, now + duration);
  gain.gain.setValueAtTime(vol || 0.15, now);
  gain.gain.exponentialRampToValueAtTime(0.001, now + duration);
  osc.connect(gain);
  gain.connect(ctx.destination);
  osc.start(now);
  osc.stop(now + duration);
}

/** 噪音发生器——用于滑铲、撞击等 */
function playNoise(duration, vol, filterFreq) {
  if (!G.audioReady) return;
  const ctx = G.audioCtx;
  const now = ctx.currentTime;
  const bufferSize = Math.floor(ctx.sampleRate * duration);
  const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
  const data = buffer.getChannelData(0);
  for (let i = 0; i < bufferSize; i++) {
    data[i] = (Math.random() * 2 - 1) * (1 - i / bufferSize); // 衰减包络
  }
  const source = ctx.createBufferSource();
  source.buffer = buffer;
  const gain = ctx.createGain();
  gain.gain.setValueAtTime(vol || 0.1, now);
  gain.gain.exponentialRampToValueAtTime(0.001, now + duration);

  let node = source;
  if (filterFreq) {
    const filter = ctx.createBiquadFilter();
    filter.type = 'lowpass';
    filter.frequency.setValueAtTime(filterFreq, now);
    source.connect(filter);
    node = filter;
  }
  node.connect(gain);
  gain.connect(ctx.destination);
  source.start(now);
  source.stop(now + duration);
}

/* 各音效快捷函数 */
function sfxJump() {
  playSound(350, 'square', 0.15, 0.08, { freqEnd: 700 });
}

function sfxSlide() {
  playNoise(0.12, 0.06, 800);
}

function sfxCoin() {
  if (!G.audioReady) return;
  const ctx = G.audioCtx;
  const now = ctx.currentTime;
  [880, 1320].forEach((f, i) => {
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = 'square';
    osc.frequency.setValueAtTime(f, now + i * 0.06);
    gain.gain.setValueAtTime(0.06, now + i * 0.06);
    gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.06 + 0.1);
    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.start(now + i * 0.06);
    osc.stop(now + i * 0.06 + 0.1);
  });
}

function sfxHurt() {
  if (!G.audioReady) return;
  const ctx = G.audioCtx;
  const now = ctx.currentTime;
  /* 低频撞击 + 噪音 */
  const osc = ctx.createOscillator();
  const gain = ctx.createGain();
  osc.type = 'triangle';
  osc.frequency.setValueAtTime(120, now);
  osc.frequency.exponentialRampToValueAtTime(40, now + 0.2);
  gain.gain.setValueAtTime(0.15, now);
  gain.gain.exponentialRampToValueAtTime(0.001, now + 0.2);
  osc.connect(gain);
  gain.connect(ctx.destination);
  osc.start(now);
  osc.stop(now + 0.2);
  playNoise(0.1, 0.08, 300);
}

function sfxDeath() {
  if (!G.audioReady) return;
  const ctx = G.audioCtx;
  const now = ctx.currentTime;
  /* 下降音阶 */
  [400, 300, 200, 120].forEach((f, i) => {
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(f, now + i * 0.12);
    gain.gain.setValueAtTime(0.1, now + i * 0.12);
    gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.12 + 0.15);
    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.start(now + i * 0.12);
    osc.stop(now + i * 0.12 + 0.15);
  });
  playNoise(0.25, 0.12, 200);
}

function sfxPowerup() {
  if (!G.audioReady) return;
  const ctx = G.audioCtx;
  const now = ctx.currentTime;
  /* 上行琶音 */
  [440, 554, 659, 880].forEach((f, i) => {
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(f, now + i * 0.08);
    gain.gain.setValueAtTime(0.08, now + i * 0.08);
    gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.08 + 0.15);
    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.start(now + i * 0.08);
    osc.stop(now + i * 0.08 + 0.15);
  });
}

/* 屏幕坐标：根据世界深度计算 screenY 和缩放比例 */
function worldToScreen(dist) {
  /* dist: 0 = 玩家脚下, maxDist = 地平线 */
  const t = 1 - clamp(dist / G.maxDist, 0, 1);
  const screenY = lerp(G.vanishY, G.groundY, t);
  const scale = lerp(0.3, 1.0, t);
  return { y: screenY, scale };
}

/* 轨道 X 坐标：根据深度 + 轨道索引计算 screenX */
function laneX(laneIdx, dist) {
  const t = 1 - clamp(dist / G.maxDist, 0, 1);
  const spread = lerp(0, G.laneSpread, t);
  const centerX = G.vanishX;
  return centerX + (laneIdx - 1) * spread;
}

/* =========================== 初始化 =========================== */
function init() {
  G.canvas = document.getElementById('game');
  G.ctx = G.canvas.getContext('2d', { alpha: false });
  resize();
  window.addEventListener('resize', resize);

  /* 加载最高分 */
  try {
    G.highScore = parseInt(localStorage.getItem('railRunner_highScore')) || 0;
  } catch(e) { G.highScore = 0; }

  /* 输入：键盘 */
  window.addEventListener('keydown', e => {
    G.keys[e.key] = true;
    if (e.key === ' ' || e.key === 'ArrowUp' || e.key === 'ArrowDown') {
      e.preventDefault();
    }
    if (G.state === 'start' && e.key === ' ') startGame();
    if (G.state === 'dead' && e.key === ' ') restartGame();
  });
  window.addEventListener('keyup', e => { G.keys[e.key] = false; });

  /* 输入：触屏 */
  G.canvas.addEventListener('touchstart', e => {
    e.preventDefault();
    if (G.state === 'start') { startGame(); return; }
    if (G.state === 'dead') { restartGame(); return; }
    const t = e.touches[0];
    G.swipeStart = { x: t.clientX, y: t.clientY, time: Date.now() };
  }, { passive: false });

  G.canvas.addEventListener('touchend', e => {
    if (!G.swipeStart) return;
    const t = e.changedTouches[0];
    const dx = t.clientX - G.swipeStart.x;
    const dy = t.clientY - G.swipeStart.y;
    const dt = Date.now() - G.swipeStart.time;
    const absDx = Math.abs(dx), absDy = Math.abs(dy);

    if (Math.max(absDx, absDy) < 20) return; // 太小忽略

    if (absDx > absDy) {
      G.lastSwipe = dx > 0 ? 'right' : 'left';
    } else {
      G.lastSwipe = dy > 0 ? 'down' : 'up';
    }
    G.swipeStart = null;
  });

  /* 玩家 */
  G.player = createPlayer();

  /* 预渲染 */
  preRenderAssets();

  /* 启动循环 */
  G.lastTime = performance.now();
  requestAnimationFrame(gameLoop);
}

function resize() {
  const container = document.getElementById('game-container');
  const rect = container.getBoundingClientRect();
  const dpr = Math.min(window.devicePixelRatio || 1, 2); // 限制像素比
  G.W = rect.width;
  G.H = rect.height;
  G.canvas.width = G.W * dpr;
  G.canvas.height = G.H * dpr;
  G.canvas.style.width = G.W + 'px';
  G.canvas.style.height = G.H + 'px';
  G.ctx.setTransform(1, 0, 0, 1, 0, 0);
  G.ctx.scale(dpr, dpr);

  /* 重新计算透视参数 */
  G.vanishX = G.W * 0.5;
  G.vanishY = G.H * 0.28;
  G.groundY = G.H * 0.88;
  G.laneSpread = G.W * 0.18;

  /* 预渲染需要 resize */
  preRenderAssets();
}

/* =========================== 预渲染资源 =========================== */
function preRenderAssets() {
  /* --- 天空渐变背景 --- */
  const skyCanvas = document.createElement('canvas');
  skyCanvas.width = G.W;
  skyCanvas.height = G.H;
  const skyCtx = skyCanvas.getContext('2d');
  const grad = skyCtx.createLinearGradient(0, 0, 0, G.vanishY + 40);
  grad.addColorStop(0, '#1a1a4e');
  grad.addColorStop(0.5, '#2d4a8e');
  grad.addColorStop(1, '#5ba3d9');
  skyCtx.fillStyle = grad;
  skyCtx.fillRect(0, 0, G.W, G.H);
  /* 云层 */
  skyCtx.fillStyle = 'rgba(255,255,255,0.08)';
  for (let ci = 0; ci < 8; ci++) {
    const cx = Math.random() * G.W;
    const cy = Math.random() * G.vanishY * 0.7;
    const cw = 60 + Math.random() * 120;
    skyCtx.beginPath();
    skyCtx.ellipse(cx, cy, cw, 12 + Math.random() * 10, 0, 0, Math.PI * 2);
    skyCtx.fill();
    skyCtx.beginPath();
    skyCtx.ellipse(cx + cw*0.3, cy - 8, cw*0.6, 10 + Math.random() * 8, 0, 0, Math.PI * 2);
    skyCtx.fill();
  }
  G.offscreen.sky = skyCanvas;

  /* --- 城市天际线（远景） --- */
  const cityCanvas = document.createElement('canvas');
  cityCanvas.width = G.W * 3; // 宽于屏幕用于视差滚动
  cityCanvas.height = G.H * 0.25;
  const cityCtx = cityCanvas.getContext('2d');
  /* 建筑剪影 */
  cityCtx.fillStyle = '#1a1a3e';
  const buildings = [];
  let bx = 0;
  while (bx < cityCanvas.width) {
    const bw = randInt(30, 100);
    const bh = randInt(40, cityCanvas.height * 0.85);
    buildings.push({ x: bx, w: bw, h: bh });
    bx += bw + randInt(5, 20);
  }
  buildings.forEach(b => {
    cityCtx.fillRect(b.x, cityCanvas.height - b.h, b.w, b.h);
    /* 远处涂鸦（简化色块） */
    if (Math.random() < 0.2 && b.w > 50) {
      const tagColors = ['#ff3366','#ff6600','#33ff66','#33ccff','#ff33cc'];
      cityCtx.fillStyle = tagColors[Math.floor(Math.random() * tagColors.length)];
      cityCtx.fillRect(b.x + 8, cityCanvas.height - b.h + 10, b.w - 16, 8);
    }
    /* 窗户光点 */
    cityCtx.fillStyle = 'rgba(255,220,150,0.3)';
    for (let wy = cityCanvas.height - b.h + 8; wy < cityCanvas.height - 8; wy += 12) {
      for (let wx = b.x + 6; wx < b.x + b.w - 6; wx += 10) {
        if (Math.random() < 0.4) cityCtx.fillRect(wx, wy, 3, 3);
      }
    }
    cityCtx.fillStyle = '#1a1a3e';
  });
  G.offscreen.city = cityCanvas;

  /* --- 近景建筑（更大、暖色调） --- */
  const nearCanvas = document.createElement('canvas');
  nearCanvas.width = G.W * 2;
  nearCanvas.height = G.H * 0.35;
  const nearCtx = nearCanvas.getContext('2d');
  nearCtx.fillStyle = '#2a1a0a';
  let nx = 0;
  while (nx < nearCanvas.width) {
    const nw = randInt(60, 160);
    const nh = randInt(80, nearCanvas.height * 0.9);
    nearCtx.fillRect(nx, nearCanvas.height - nh, nw, nh);
    /* 更大更亮的窗户 */
    nearCtx.fillStyle = 'rgba(255,200,100,0.2)';
    for (let wy = nearCanvas.height - nh + 12; wy < nearCanvas.height - 10; wy += 16) {
      for (let wx = nx + 10; wx < nx + nw - 10; wx += 14) {
        if (Math.random() < 0.35) nearCtx.fillRect(wx, wy, 5, 6);
      }
    }
    /* 随机涂鸦标签（30%几率） */
    if (Math.random() < 0.3) {
      const tagW = randInt(30, nw - 10);
      const tagH = randInt(20, Math.min(60, nh - 20));
      const tagX = nx + randInt(5, nw - tagW - 5);
      const tagY = nearCanvas.height - nh + randInt(10, nh - tagH - 10);
      drawGraffitiTag(nearCtx, tagX, tagY, tagW, tagH);
    }
    nearCtx.fillStyle = '#2a1a0a';
    nx += nw + randInt(8, 30);
  }
  G.offscreen.nearCity = nearCanvas;

  /* --- 玩家精灵 预渲染 --- */
  G.offscreen.player = {};
  ['run', 'jump', 'slide', 'hit'].forEach(state => {
    const pc = document.createElement('canvas');
    pc.width = 80; pc.height = 100;
    drawPlayerSprite(pc.getContext('2d'), state, pc.width, pc.height);
    G.offscreen.player[state] = pc;
  });

  /* --- 障碍物图块 --- */
  G.offscreen.obstacles = {};
  /* 低障碍（横杆） */
  let oc = document.createElement('canvas'); oc.width=60; oc.height=20;
  drawObstacleSprite(oc.getContext('2d'), OBS_LOW, oc.width, oc.height);
  G.offscreen.obstacles[OBS_LOW] = oc;
  /* 中障碍（信号灯箱） */
  oc = document.createElement('canvas'); oc.width=40; oc.height=55;
  drawObstacleSprite(oc.getContext('2d'), OBS_MID, oc.width, oc.height);
  G.offscreen.obstacles[OBS_MID] = oc;
  /* 高障碍（信号塔） */
  oc = document.createElement('canvas'); oc.width=50; oc.height=120;
  drawObstacleSprite(oc.getContext('2d'), OBS_HIGH, oc.width, oc.height);
  G.offscreen.obstacles[OBS_HIGH] = oc;

  /* --- 金币 --- */
  const coinCanvas = document.createElement('canvas');
  coinCanvas.width = 32; coinCanvas.height = 32;
  drawCoinSprite(coinCanvas.getContext('2d'), coinCanvas.width, coinCanvas.height);
  G.offscreen.coin = coinCanvas;

  /* --- 粒子 --- */
  const partCanvas = document.createElement('canvas');
  partCanvas.width = 8; partCanvas.height = 8;
  const partCtx = partCanvas.getContext('2d');
  partCtx.fillStyle = '#fff';
  partCtx.beginPath(); partCtx.arc(4,4,4,0,Math.PI*2); partCtx.fill();
  G.offscreen.particle = partCanvas;
}

/* =========================== 精灵绘制 =========================== */
/* 涂鸦标签 -- 在指定位置绘制随机涂鸦 */
function drawGraffitiTag(ctx, x, y, w, h) {
  const colors = ['#ff3366','#ff6600','#ffcc00','#33ff66','#33ccff','#ff33cc','#aaff00','#ff0066'];
  const bgColors = ['#1a1a2e','#2a1a4e','#1a3a2e','#3a1a2e','#2a2a4e'];

  /* 背景色块（涂鸦底板） */
  const bg = randChoice(bgColors);
  ctx.fillStyle = bg;
  ctx.fillRect(x, y, w, h);
  ctx.strokeStyle = 'rgba(255,255,255,0.2)';
  ctx.lineWidth = 1;
  ctx.strokeRect(x, y, w, h);

  /* 涂鸦文字/图案 */
  const tagColor = randChoice(colors);
  ctx.fillStyle = tagColor;

  /* 随机选择涂鸦风格 */
  const style = randInt(0, 4);
  const cx = x + w/2, cy = y + h/2;

  if (style === 0) {
    /* 气泡字体风格 -- 重叠的圆 */
    ctx.globalAlpha = 0.8;
    for (let i = 0; i < 5; i++) {
      const bx = x + 10 + Math.random() * (w - 20);
      const by = y + 10 + Math.random() * (h - 20);
      const br = 8 + Math.random() * 15;
      ctx.beginPath(); ctx.arc(bx, by, br, 0, Math.PI*2); ctx.fill();
    }
    ctx.globalAlpha = 1;
  } else if (style === 1) {
    /* 喷漆线条 -- 粗犷的水平条纹 */
    ctx.lineWidth = 4 + Math.random() * 8;
    ctx.strokeStyle = tagColor;
    for (let i = 0; i < 4; i++) {
      ctx.beginPath();
      const ly = y + 10 + i * h/4;
      ctx.moveTo(x + 5, ly);
      ctx.lineTo(x + w - 5, ly + (Math.random()-0.5)*10);
      ctx.stroke();
    }
  } else if (style === 2) {
    /* 箭头/三角形涂鸦 */
    ctx.beginPath();
    ctx.moveTo(cx, cy - h*0.3);
    ctx.lineTo(cx + w*0.35, cy + h*0.25);
    ctx.lineTo(cx - w*0.35, cy + h*0.25);
    ctx.closePath(); ctx.fill();
    /* 内圈 */
    ctx.fillStyle = bg;
    ctx.beginPath(); ctx.arc(cx, cy + h*0.05, w*0.12, 0, Math.PI*2); ctx.fill();
  } else if (style === 3) {
    /* 星形/爆炸 */
    const spikes = randInt(5, 8);
    ctx.beginPath();
    for (let i = 0; i < spikes * 2; i++) {
      const r = i % 2 === 0 ? Math.min(w,h)*0.4 : Math.min(w,h)*0.15;
      const angle = (i / (spikes * 2)) * Math.PI * 2 - Math.PI/2;
      const px = cx + Math.cos(angle) * r;
      const py = cy + Math.sin(angle) * r;
      if (i === 0) ctx.moveTo(px, py);
      else ctx.lineTo(px, py);
    }
    ctx.closePath(); ctx.fill();
  } else {
    /* 滴落风格 -- 垂直线条 + 圆点 */
    const drops = randInt(3, 7);
    for (let i = 0; i < drops; i++) {
      const dx = x + w * (0.2 + Math.random() * 0.6);
      ctx.beginPath();
      ctx.moveTo(dx, y + 5);
      ctx.lineTo(dx, y + h * (0.3 + Math.random() * 0.5));
