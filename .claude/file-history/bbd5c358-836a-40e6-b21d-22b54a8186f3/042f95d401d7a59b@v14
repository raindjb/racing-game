/* =========================== 对象池 =========================== */
function poolGet(pool, factory) {
  for (let i = 0; i < pool.length; i++) {
    if (!pool[i].active) { pool[i].active = true; return pool[i]; }
  }
  const obj = factory();
  obj.active = true;
  pool.push(obj);
  return obj;
}

function poolReleaseAll(pool) {
  for (let i = 0; i < pool.length; i++) pool[i].active = false;
}

/* =========================== 创建对象 =========================== */
function createPlayer() {
  return {
    lane: PLAYER_LANE,
    targetLane: PLAYER_LANE,
    state: STATE_RUN,
    stateTimer: 0,
    jumpVel: 0,
    slideTimer: 0,
    animFrame: 0,
    animTimer: 0,
    x: 0, y: 0,            // 屏幕坐标（每帧更新）
    scale: 1,
    /* 道具 */
    activePowerup: null,
    powerupTimer: 0,
    hasShield: false,       // 护盾独立状态（持续到被消耗）
    scoreMultiplier: 1,
  };
}

function createObstacle(lane, type, dist) {
  return {
    active: true,
    lane,
    type,
    dist,                  // 世界距离（从远处向玩家移动）
    passed: false,
  };
}

function createCoin(lane, dist) {
  return {
    active: true,
    lane,
    dist,
    collected: false,
    sparkTimer: 0,
  };
}

function createPowerup(lane, type, dist) {
  return {
    active: true,
    lane,
    type,
    dist,
    collected: false,
    sparkTimer: 0,
    floatPhase: Math.random() * Math.PI * 2,
  };
}

function createParticle(x, y, vx, vy, life, color) {
  return {
    active: true,
    x, y, vx, vy, life, maxLife: life,
    color,
    size: randInt(2, 5),
  };
}

/* =========================== 游戏流程 =========================== */
function startGame() {
  initAudio();
  G.state = 'playing';
  G.score = 0;
  G.coinScore = 0;
  G.distance = 0;
  G.speed = BASE_SPEED;
  G.hearts = MAX_HEARTS;
  G.invincible = 0;
  G.spawnTimer = 60; // 给玩家起步空间
  G.spawnInterval = 300;
  G.coinTimer = 15;
  G.laneCooldown = 0;
  G.player = createPlayer();
  poolReleaseAll(G.obstacles);
  poolReleaseAll(G.coins);
  poolReleaseAll(G.particles);
  poolReleaseAll(G.powerups);
  G.powerupSpawnTimer = 300;
}

function restartGame() {
  if (G.state === 'dead') startGame();
}

function die() {
  sfxDeath();
  G.state = 'dead';
  G.player.state = STATE_HIT;
  G.player.stateTimer = 0;
  /* 保存最高分 */
  if (G.score > G.highScore) {
    G.highScore = G.score;
    try { localStorage.setItem('railRunner_highScore', G.highScore); } catch(e) {}
  }
  /* 爆炸粒子 */
  const s = G.player;
  for (let i = 0; i < 25; i++) {
    const p = poolGet(G.particles, () => createParticle(0,0,0,0,0,'#fff'));
    p.x = s.x + (Math.random()-0.5)*50;
    p.y = s.y + (Math.random()-0.5)*60;
    p.vx = (Math.random()-0.5)*8;
    p.vy = (Math.random()-0.5)*8;
    p.life = randInt(20, 50);
    p.maxLife = p.life;
    p.color = randChoice(['#ff4444','#ffaa00','#ffe644','#ff6644','#fff']);
  }
}

function hurtPlayer(damage) {
  if (G.invincible > 0) return;
  /* 护盾吸收 */
  if (G.player.hasShield) {
    G.player.hasShield = false;
    G.invincible = INVINCIBLE_FRAMES;
    playNoise(0.15, 0.08, 2000); // 护盾破碎音效
    return;
  }
  sfxHurt();
  G.shakeDuration = 12;
  G.shakeX = 6;
  G.shakeY = 4;
  G.flashAlpha = 0.25;
  G.hearts -= damage;
  G.invincible = INVINCIBLE_FRAMES;
  if (G.hearts <= 0) {
    G.hearts = 0;
    die();
  } else {
    G.player.state = STATE_HIT;
    G.player.stateTimer = 18; // 短暂后仰
  }
}

/* =========================== 输入处理 =========================== */
function processInput() {
  if (G.state !== 'playing') return;

  let moveLR = 0;
  let jump = false;
  let slide = false;

  /* 键盘 */
  if (G.keys['ArrowLeft'] || G.keys['a'] || G.keys['A']) moveLR = -1;
  if (G.keys['ArrowRight'] || G.keys['d'] || G.keys['D']) moveLR = 1;
  if (G.keys['ArrowUp'] || G.keys['w'] || G.keys['W']) jump = true;
  if (G.keys['ArrowDown'] || G.keys['s'] || G.keys['S']) slide = true;

  /* 触屏 */
  if (G.lastSwipe === 'left') { moveLR = -1; G.lastSwipe = ''; }
  if (G.lastSwipe === 'right') { moveLR = 1; G.lastSwipe = ''; }
  if (G.lastSwipe === 'up') { jump = true; G.lastSwipe = ''; }
  if (G.lastSwipe === 'down') { slide = true; G.lastSwipe = ''; }

  const p = G.player;
  /* 换道——加冷却防止连按瞬移 */
  if (G.laneCooldown > 0) G.laneCooldown--;
  if (moveLR !== 0 && p.state !== STATE_SLIDE && G.laneCooldown <= 0) {
    p.targetLane = clamp(p.targetLane + moveLR, 0, LANE_COUNT - 1);
    G.laneCooldown = 8; // ~0.13秒冷却
  }
  /* 跳跃 */
  if (jump && p.state === STATE_RUN) {
    p.state = STATE_JUMP;
    p.stateTimer = 100;
    p.jumpVel = -4;
    sfxJump();
  }
  /* 滑铲 */
  if (slide && p.state === STATE_RUN) {
    p.state = STATE_SLIDE;
    p.stateTimer = 22;
    sfxSlide();
  }

  /* 消耗一次性按键 */
  G.keys['ArrowLeft'] = false; G.keys['a'] = false; G.keys['A'] = false;
  G.keys['ArrowRight'] = false; G.keys['d'] = false; G.keys['D'] = false;
  G.keys['ArrowUp'] = false; G.keys['w'] = false; G.keys['W'] = false;
  G.keys['ArrowDown'] = false; G.keys['s'] = false; G.keys['S'] = false;
}

/* =========================== 游戏更新 =========================== */
function update() {
  if (G.state !== 'playing') return;

  const p = G.player;

  /* --- 速度 & 距离 --- */
  G.speed = Math.min(G.speed + SPEED_INC, MAX_SPEED);
  G.distance += G.speed * DISTANCE_PER_FRAME;
  G.score = Math.floor(G.distance * DISTANCE_SCORE * G.player.scoreMultiplier) + G.coinScore;

  /* --- 无敌计时 --- */
  if (G.invincible > 0) G.invincible--;

  /* 屏幕震动衰减 */
  if (G.shakeDuration > 0) {
    G.shakeDuration--;
    G.shakeX *= 0.8;
    G.shakeY *= 0.8;
  } else {
    G.shakeX = 0; G.shakeY = 0;
  }
  /* 红色闪屏衰减 */
  if (G.flashAlpha > 0) G.flashAlpha -= 0.02;

  /* --- 轨道平滑切换 --- */
  p.lane = lerp(p.lane, p.targetLane, 0.25);

  /* --- 玩家状态 --- */
  if (p.state === STATE_JUMP) {
    p.stateTimer--;
    if (p.stateTimer <= 0) {
      p.state = STATE_RUN;
      p.stateTimer = 0;
    }
  } else if (p.state === STATE_SLIDE) {
    p.stateTimer--;
    if (p.stateTimer <= 0) {
      p.state = STATE_RUN;
      p.stateTimer = 0;
    }
  } else if (p.state === STATE_HIT) {
    p.stateTimer--;
    if (p.stateTimer <= 0) {
      p.state = STATE_RUN;
    }
  }

  /* --- 动画帧 --- */
  p.animTimer++;
  if (p.animTimer > 8) {
    p.animTimer = 0;
    p.animFrame = (p.animFrame + 1) % 4;
  }

  /* --- 移动障碍物 --- */
  for (let i = 0; i < G.obstacles.length; i++) {
    const obs = G.obstacles[i];
    if (!obs.active) continue;
    obs.dist -= G.speed;
    if (obs.dist < -30) { obs.active = false; continue; }
    /* 碰撞检测（仅当障碍物接近玩家时） */
    if (!obs.passed && obs.dist < 18 && obs.dist > -5) {
      if (sameLane(obs)) {
        /* 低障碍：滑铲可通过 */
        if (obs.type === OBS_LOW && p.state === STATE_SLIDE) continue;
        /* 中障碍：跳跃可通过 */
        if (obs.type === OBS_MID && p.state === STATE_JUMP) continue;
        /* 高障碍：必须换道——同轨即受伤 */
        hurtPlayer(1);
      }
    }
  }

  /* --- 移动金币 --- */
  for (let i = 0; i < G.coins.length; i++) {
    const coin = G.coins[i];
    if (!coin.active) continue;
    coin.dist -= G.speed;
    if (coin.dist < -30) { coin.active = false; continue; }
    /* 收集检测 */
    if (!coin.collected && coin.dist < 28 && coin.dist > -18 && Math.abs(coin.lane - p.lane) < 0.85) {
      coin.collected = true;
      coin.sparkTimer = 10;
      G.coinScore += COIN_SCORE * G.player.scoreMultiplier;
      sfxCoin();
      /* 收集粒子 */
      const s = worldToScreen(coin.dist);
      const sx = laneX(coin.lane, coin.dist);
      for (let j = 0; j < 6; j++) {
        const pt = poolGet(G.particles, () => createParticle(0,0,0,0,0,'#ff0'));
        pt.x = sx + (Math.random()-0.5)*20;
        pt.y = s.y + (Math.random()-0.5)*20;
        pt.vx = (Math.random()-0.5)*4;
        pt.vy = (Math.random()-0.5)*4 - 2;
        pt.life = randInt(10, 25);
        pt.maxLife = pt.life;
        pt.color = randChoice(['#ffdd44','#ffaa00','#ffe680','#fff']);
      }
    }
  }

  /* --- 更新粒子 --- */
  for (let i = 0; i < G.particles.length; i++) {
    const pt = G.particles[i];
    if (!pt.active) continue;
    pt.x += pt.vx;
    pt.y += pt.vy;
    pt.life--;
    if (pt.life <= 0) pt.active = false;
  }

  /* --- 生成障碍物 --- */
  G.spawnTimer++;
  const interval = G.spawnInterval / (G.speed / BASE_SPEED);
  if (G.spawnTimer >= interval) {
    G.spawnTimer = 0;
    spawnObstacle();
  }

  /* --- 生成金币 --- */
  G.coinTimer++;
  if (G.coinTimer > 150 + Math.random() * 120) {
    G.coinTimer = 0;
    spawnCoinRow();
  }
  /* 道具系统 */
  if (!G.powerupSpawnTimer) G.powerupSpawnTimer = 300 + Math.random() * 400;
  G.powerupSpawnTimer--;
  if (G.powerupSpawnTimer <= 0) {
    G.powerupSpawnTimer = 300 + Math.random() * 400;
    if (G.powerups.filter(pu => pu.active).length < 2) spawnPowerup();
  }
  /* 道具移动 & 收集 */
  for (let i = 0; i < G.powerups.length; i++) {
    const pu = G.powerups[i];
    if (!pu.active) continue;
    pu.dist -= G.speed;
    if (pu.dist < -40) { pu.active = false; continue; }
    pu.floatPhase += 0.05;
    if (!pu.collected && pu.dist < 28 && pu.dist > -18 && Math.abs(pu.lane - p.lane) < 0.85) {
      pu.collected = true;
      pu.sparkTimer = 12;
      sfxPowerup();
      applyPowerup(p, pu.type);
      const s = worldToScreen(pu.dist);
      const sx = laneX(pu.lane, pu.dist);
      for (let j = 0; j < 10; j++) {
        const pt = poolGet(G.particles, () => createParticle(0,0,0,0,0,'#fff'));
        pt.x = sx + (Math.random()-0.5)*30;
        pt.y = s.y + (Math.random()-0.5)*30;
        pt.vx = (Math.random()-0.5)*6;
        pt.vy = (Math.random()-0.5)*6 - 3;
        pt.life = randInt(15, 35);
        pt.maxLife = pt.life;
        pt.color = pu.type === PUP_MAGNET ? '#ff44ff' : pu.type === PUP_SHIELD ? '#44aaff' : '#ffdd00';
      }
    }
  }
  /* 道具计时器 & 磁铁效果 */
  if (p.powerupTimer > 0) {
    p.powerupTimer--;
    if (p.powerupTimer <= 0) {
      p.activePowerup = null;
      p.scoreMultiplier = 1;
    }
  }
  if (p.activePowerup === PUP_MAGNET) {
    for (let i = 0; i < G.coins.length; i++) {
      const c = G.coins[i];
      if (!c.active || c.collected) continue;
      if (Math.abs(c.lane - p.lane) < MAGNET_RANGE && c.dist < 80 && c.dist > -20) {
        c.lane += (p.lane - c.lane) * 0.08;
        c.dist -= G.speed * 0.3;
      }
    }
  }

  /* --- 清理远处对象 --- */
  cleanupPool(G.obstacles);
  cleanupPool(G.coins);
  cleanupPool(G.particles);
  cleanupPool(G.powerups);

  /* --- 计算玩家屏幕坐标 --- */
  p.y = G.groundY;
  if (p.state === STATE_JUMP) {
    p.y = G.groundY - 50 - (p.stateTimer / 100) * 35;
  }
  p.scale = 1.0;
  p.x = laneX(p.lane, 0);

  /* 奔跑扬尘 */
  if (G.frameCount % 4 === 0 && G.state === 'playing') {
    for (let i = 0; i < 2; i++) {
      const pt = poolGet(G.particles, () => createParticle(0,0,0,0,0,'#fff'));
      pt.x = p.x + (Math.random()-0.5)*20;
      pt.y = G.groundY + 12;
      pt.vx = (Math.random()-0.5)*0.8;
      pt.vy = -(0.5 + Math.random()*1.5);
      pt.life = randInt(8, 18);
      pt.maxLife = pt.life;
      pt.size = 2 + Math.random()*3;
      pt.color = 'rgba(180,160,140,0.5)';
    }
  }
}

/* =========================== 碰撞检测 =========================== */
function sameLane(obs) {
  return Math.abs(obs.lane - G.player.lane) < 0.6;
}

/* =========================== 对象生成 =========================== */
function spawnObstacle() {
  /* 选择一个障碍物类型 */
  const speedRatio = (G.speed - BASE_SPEED) / (MAX_SPEED - BASE_SPEED);
  let types;
  if (speedRatio < 0.2) {
    types = [OBS_LOW, OBS_LOW, OBS_MID];           // 早期：多低障碍
  } else if (speedRatio < 0.5) {
    types = [OBS_LOW, OBS_MID, OBS_MID, OBS_HIGH]; // 中期：引入中高障碍
  } else {
    types = [OBS_LOW, OBS_MID, OBS_HIGH, OBS_HIGH];// 后期：混合
  }
  const type = randChoice(types);

  /* 选择轨道（避免堆叠） */
  const lane = randInt(0, 2);

  /* 检查同轨道前方是否有障碍物太近 */
  for (let i = 0; i < G.obstacles.length; i++) {
    const obs = G.obstacles[i];
    if (obs.active && obs.lane === lane && obs.dist > G.maxDist - 100 && obs.dist < G.maxDist - 30) {
      return; // 太近，跳过
    }
  }

  const o = poolGet(G.obstacles, () => createObstacle(0, OBS_LOW, 0));
  o.lane = lane;
  o.type = type;
  o.dist = G.maxDist;
  o.passed = false;
}

function spawnCoinRow() {
  /* 单条轨道，几个金币 */
  const lane = randInt(0, 2);
  for (let d = G.maxDist - 20; d < G.maxDist + 20; d += 60) {
    const c = poolGet(G.coins, () => createCoin(0, 0));
    c.lane = lane;
    c.dist = d + Math.random() * 10;
    c.collected = false;
  }
}

function spawnPowerup() {
  const lane = randInt(0, 2);
  const type = randChoice([PUP_MAGNET, PUP_SHIELD, PUP_2X]);
  const pu = poolGet(G.powerups, () => createPowerup(0, PUP_MAGNET, 0));
  pu.lane = lane;
  pu.type = type;
  pu.dist = G.maxDist + randInt(0, 50);
  pu.collected = false;
}


function applyPowerup(p, type) {
  if (type === PUP_SHIELD) {
    p.hasShield = true;
  } else {
    p.activePowerup = type;
    p.powerupTimer = POWERUP_DURATION;
    if (type === PUP_2X) p.scoreMultiplier = 2;
  }
}
function cleanupPool(pool) {
  /* 只清理距离很远且已失效的对象，减少 splice 操作 */
  /* 实际：对象池不真正删除，只标记 inactive 并在获取时复用 */
}

/* =========================== 渲染 =========================== */
function render() {
  const ctx = G.ctx;
  ctx.clearRect(0, 0, G.W, G.H);

  /* 屏幕震动 */
  ctx.save();
  if (G.shakeDuration > 0) {
    ctx.translate(
      (Math.random() - 0.5) * G.shakeX * 2,
      (Math.random() - 0.5) * G.shakeY * 2
    );
  }

  /* --- 天空 --- */
  ctx.drawImage(G.offscreen.sky, 0, 0);

  /* --- 远城市场景视差 --- */
  const cityOffset = (G.distance * 0.15) % (G.W * 3);
  ctx.drawImage(G.offscreen.city, -cityOffset, G.vanishY - 30, G.W, G.H*0.25, 0, G.vanishY - 30, G.W, G.H*0.25);

  /* --- 近建筑视差 --- */
  const nearOffset = (G.distance * 0.3) % (G.W * 2);
  ctx.drawImage(G.offscreen.nearCity, -nearOffset, G.vanishY + 10, G.W, G.H*0.35, 0, G.vanishY + 10, G.W, G.H*0.35);

  /* --- 地面 --- */
  drawGround(ctx);

  /* --- 轨道 --- */
  drawTracks(ctx);

  /* --- 收集所有需要深度排序的实体 --- */
  const entities = [];

  /* 障碍物 */
  for (let i = 0; i < G.obstacles.length; i++) {
    const o = G.obstacles[i];
    if (!o.active) continue;
    entities.push({ type:'obstacle', obj:o, dist:o.dist, lane:o.lane });
  }

  /* 金币 */
  for (let i = 0; i < G.coins.length; i++) {
    const c = G.coins[i];
    if (!c.active || c.collected) continue;
    entities.push({ type:'coin', obj:c, dist:c.dist, lane:c.lane });
  }

  /* 道具 */
  for (let i = 0; i < G.powerups.length; i++) {
    const pu = G.powerups[i];
    if (!pu.active || pu.collected) continue;
    entities.push({ type:'powerup', obj:pu, dist:pu.dist, lane:pu.lane });
  }

  /* 按距离排序（远处先画） */
  entities.sort((a, b) => b.dist - a.dist);

  /* --- 绘制所有实体 --- */
  entities.forEach(e => {
    const s = worldToScreen(e.dist);
    if (s.y < G.vanishY - 20 || s.y > G.H + 20) return;
    const sx = laneX(e.lane, e.dist);

    if (e.type === 'obstacle') {
      drawObstacle(ctx, e.obj, sx, s.y, s.scale);
    } else if (e.type === 'coin') {
      drawCoin(ctx, e.obj, sx, s.y, s.scale);
    } else if (e.type === 'powerup') {
      drawPowerup(ctx, e.obj, sx, s.y, s.scale);
    }
  });

  /* --- 玩家 --- */
  drawPlayer(ctx);

  /* --- 粒子（玩家上方） --- */
  for (let i = 0; i < G.particles.length; i++) {
    const p = G.particles[i];
    if (!p.active) continue;
    const alpha = p.life / p.maxLife;
    ctx.globalAlpha = alpha;
    ctx.fillStyle = p.color;
    ctx.fillRect(p.x - p.size/2, p.y - p.size/2, p.size, p.size);
  }
  ctx.globalAlpha = 1;

  /* 恢复震动偏移 */
  ctx.restore();

  /* --- 速度线（高速时屏幕边缘拉伸线） --- */
  const speedRatio = (G.speed - BASE_SPEED) / (MAX_SPEED - BASE_SPEED);
  if (speedRatio > 0.3 && G.state === 'playing') {
    const intensity = (speedRatio - 0.3) * 0.5;
    ctx.strokeStyle = `rgba(255,255,255,${intensity * 0.3})`;
    ctx.lineWidth = 1;
    for (let i = 0; i < 12; i++) {
      const ly = Math.random() * G.H;
      const lx = Math.random() * G.W;
      const len = 20 + Math.random() * 40 * intensity;
      ctx.beginPath();
      ctx.moveTo(lx, ly);
      ctx.lineTo(lx + len, ly);
      ctx.stroke();
    }
  }

  /* --- 受伤红色闪屏 --- */
  if (G.flashAlpha > 0) {
    ctx.fillStyle = `rgba(255,40,40,${G.flashAlpha})`;
    ctx.fillRect(0, 0, G.W, G.H);
  }

  /* --- HUD --- */
  drawHUD(ctx);

  /* --- 界面状态 --- */
  if (G.state === 'start') drawStartScreen(ctx);
  if (G.state === 'dead') drawDeathScreen(ctx);
}

/* =========================== 绘制地面 =========================== */
function drawGround(ctx) {
  /* 地面区域：从消失点下方到屏幕底 */
  const groundTop = G.vanishY + 30;
  const groundBot = G.H;

  /* 碎石地表渐变 */
  const grad = ctx.createLinearGradient(0, groundTop, 0, groundBot);
  grad.addColorStop(0, '#8b7355');
  grad.addColorStop(0.3, '#9b8b75');
  grad.addColorStop(0.7, '#a09080');
  grad.addColorStop(1, '#b0a090');
  ctx.fillStyle = grad;
  ctx.fillRect(0, groundTop, G.W, groundBot - groundTop);

  /* 碎石纹理点 */
  ctx.fillStyle = 'rgba(120,110,100,0.3)';
  const seed = 42; // 固定种子保持稳定
  for (let y = groundTop; y < groundBot; y += 12) {
    for (let x = 0; x < G.W; x += 14) {
      if (((x * 31 + y * 17 + seed) % 7) === 0) {
        ctx.fillRect(x, y, 2, 2);
      }
    }
  }
}

/* =========================== 绘制轨道 =========================== */
function drawTracks(ctx) {
  for (let lane = 0; lane < LANE_COUNT; lane++) {
    /* 钢轨 */
    const railWidth = 5;

    /* 左轨 */
    ctx.strokeStyle = '#8899aa';
    ctx.lineWidth = railWidth;
    ctx.beginPath();
    for (let d = 0; d <= G.maxDist; d += 20) {
      const s = worldToScreen(d);
      const lx = laneX(lane, d) - 8;
      if (d === 0) ctx.moveTo(lx, s.y);
      else ctx.lineTo(lx, s.y);
    }
    ctx.stroke();

    /* 右轨 */
    ctx.beginPath();
    for (let d = 0; d <= G.maxDist; d += 20) {
      const s = worldToScreen(d);
      const rx = laneX(lane, d) + 8;
      if (d === 0) ctx.moveTo(rx, s.y);
      else ctx.lineTo(rx, s.y);
    }
    ctx.stroke();

    /* 枕木 */
    ctx.strokeStyle = '#6b5b4a';
    ctx.lineWidth = 3;
    for (let d = 20; d < G.maxDist; d += 60) {
      const s = worldToScreen(d);
      const lx = laneX(lane, d);
      ctx.beginPath();
      ctx.moveTo(lx - 10, s.y);
      ctx.lineTo(lx + 10, s.y);
      ctx.stroke();
    }
  }
}

/* =========================== 绘制障碍物 =========================== */
function drawObstacle(ctx, obs, sx, sy, scale) {
  ctx.save();
  ctx.translate(sx, sy);
  ctx.scale(scale, scale);

  /* 直接绘制——绕开离屏精灵定位问题 */
  if (obs.type === OBS_LOW) {
    /* 道口横栏（低障碍） */
    /* 支柱 */ ctx.fillStyle = '#555';
    ctx.fillRect(-4, -16, 8, 24); ctx.fillRect(-22, -12, 8, 12); ctx.fillRect(14, -12, 8, 12);
    /* 横杆 */ ctx.fillStyle = '#222';
    ctx.fillRect(-30, -4, 60, 10);
    /* 警示条纹 */ ctx.fillStyle = '#ffcc00';
    ctx.fillRect(-28, -2, 6, 6); ctx.fillRect(-16, -2, 6, 6); ctx.fillRect(-4, -2, 6, 6);
    ctx.fillRect(8, -2, 6, 6); ctx.fillRect(20, -2, 6, 6);
    /* 红白交替 */ ctx.fillStyle = '#ff3333';
    ctx.fillRect(-28, 1, 6, 4); ctx.fillRect(-16, 1, 6, 4); ctx.fillRect(-4, 1, 6, 4);
    ctx.fillRect(8, 1, 6, 4); ctx.fillRect(20, 1, 6, 4);
    ctx.fillStyle = '#fff';
    ctx.fillRect(-22, 1, 6, 4); ctx.fillRect(-10, 1, 6, 4); ctx.fillRect(2, 1, 6, 4);
    ctx.fillRect(14, 1, 6, 4); ctx.fillRect(26, 1, 6, 4);
  } else if (obs.type === OBS_MID) {
    /* 信号控制箱（中障碍） */
    ctx.fillStyle = '#2a2a3a';
    ctx.fillRect(-18, -32, 36, 56);
    /* 金属边框 */ ctx.strokeStyle = '#555'; ctx.lineWidth = 2;
    ctx.strokeRect(-18, -32, 36, 56);
    /* 面板分隔线 */ ctx.strokeStyle = '#444'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(-18, -12); ctx.lineTo(18, -12); ctx.stroke();
    /* 信号灯 */
    const lights = [{y:-22,color:'#ff0000'},{y:-6,color:'#ffaa00'},{y:10,color:'#00ff44'}];
    lights.forEach(l => {
      ctx.fillStyle = '#111'; ctx.beginPath(); ctx.arc(0, l.y, 6, 0, Math.PI*2); ctx.fill();
      ctx.fillStyle = l.color; ctx.beginPath(); ctx.arc(0, l.y, 4, 0, Math.PI*2); ctx.fill();
      ctx.fillStyle = 'rgba(255,255,255,0.3)'; ctx.beginPath(); ctx.arc(-1, l.y-1, 1.5, 0, Math.PI*2); ctx.fill();
    });
    /* 底座 */ ctx.fillStyle = '#333';
    ctx.fillRect(-6, 22, 12, 6);
  } else if (obs.type === OBS_HIGH) {
    /* 高压信号塔（高障碍） */
    ctx.fillStyle = '#444';
    ctx.fillRect(-14, -55, 28, 100);
    /* 金属框架 */ ctx.strokeStyle = '#666'; ctx.lineWidth = 2;
    ctx.strokeRect(-14, -55, 28, 100);
    /* 叉形结构 */ ctx.strokeStyle = '#555'; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(-14, -35); ctx.lineTo(14, -15); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(14, -35); ctx.lineTo(-14, -15); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(-14, 5); ctx.lineTo(14, 25); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(14, 5); ctx.lineTo(-14, 25); ctx.stroke();
    /* 警示灯 */ ctx.fillStyle = '#ff0000';
    ctx.beginPath(); ctx.arc(0, -48, 4, 0, Math.PI*2); ctx.fill();
    /* 红白条纹段 */
    for (let sy = -55; sy < 45; sy += 14) {
      ctx.fillStyle = (Math.floor((sy+55)/14) % 2 === 0) ? '#cc3333' : '#ffffff';
      ctx.fillRect(-13, sy + 1, 26, 5);
    }
    /* 宽底座 */ ctx.fillStyle = '#333';
    ctx.fillRect(-8, 45, 16, 6);
  }

  ctx.restore();
}

/* =========================== 绘制金币 =========================== */
function drawCoin(ctx, coin, sx, sy, scale) {
  ctx.save();
  ctx.translate(sx, sy);
  const rot = (G.frameCount * 0.05 + coin.dist * 0.1) % (Math.PI * 2);
  const squish = Math.abs(Math.cos(rot));
  ctx.scale(squish * scale, scale);
  ctx.fillStyle = "#ffaa00";
  ctx.beginPath(); ctx.arc(0, 0, 12, 0, Math.PI * 2); ctx.fill();
  ctx.fillStyle = "#ffdd44";
  ctx.beginPath(); ctx.arc(0, 0, 8, 0, Math.PI * 2); ctx.fill();
  ctx.fillStyle = "#ffe680";
  ctx.beginPath(); ctx.arc(-2, -2, 3, 0, Math.PI * 2); ctx.fill();
  ctx.restore();
}


function drawPowerup(ctx, pu, sx, sy, scale) {
  ctx.save();
  ctx.translate(sx, sy + Math.sin(pu.floatPhase) * 4 * scale);
  const sz = 14 * scale;
  /* 光晕 */
  ctx.shadowColor = pu.type === PUP_MAGNET ? '#ff44ff' : pu.type === PUP_SHIELD ? '#44aaff' : '#ffdd00';
  ctx.shadowBlur = 10 * scale;
  /* 外壳 */
  ctx.fillStyle = 'rgba(255,255,255,0.85)';
  ctx.beginPath();
  ctx.arc(0, 0, sz, 0, Math.PI * 2);
  ctx.fill();
  ctx.shadowBlur = 0;
  /* 图标（简化版用字母） */
  ctx.fillStyle = pu.type === PUP_MAGNET ? '#ff44ff' : pu.type === PUP_SHIELD ? '#44aaff' : '#ffaa00';
  ctx.font = `bold ${Math.floor(14*scale)}px "Segoe UI","PingFang SC",sans-serif`;
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  const ico = pu.type === PUP_MAGNET ? 'M' : pu.type === PUP_SHIELD ? 'S' : 'x2';
  ctx.fillText(ico, 0, 0);
  ctx.restore();
}
/* =========================== 绘制玩家 =========================== */
function drawPlayer(ctx) {
  const p = G.player;
  ctx.save();
  ctx.translate(p.x, p.y);

  /* 无敌闪烁 */
  if (G.invincible > 0 && Math.floor(G.invincible / 4) % 2 === 0) {
    ctx.globalAlpha = 0.4;
  }

  /* 奔跑时的上下起伏 */
  let bounceY = 0;
  if (p.state === STATE_RUN) {
    bounceY = Math.sin(G.frameCount * 0.4) * 2;
  }

  /* 阴影 */
  ctx.fillStyle = 'rgba(0,0,0,0.3)';
  ctx.beginPath();
  ctx.ellipse(0, 14, 18, 6, 0, 0, Math.PI * 2);
  ctx.fill();

  ctx.translate(0, bounceY);

  const sprite = G.offscreen.player[p.state];
  if (sprite) {
    ctx.drawImage(sprite, -sprite.width/2, -sprite.height/2 + 8);
  }

  ctx.restore();
}

/* =========================== HUD =========================== */
function drawHUD(ctx) {
  if (G.state !== 'playing' && G.state !== 'dead') return;

  /* 左上——血量 */
  const heartSize = 18;
  for (let i = 0; i < MAX_HEARTS; i++) {
    const hx = 16 + i * (heartSize + 6);
    const hy = 16;
    if (i < G.hearts) {
      /* 满血——红色心 */
      drawHeart(ctx, hx, hy, heartSize, '#e94560');
    } else {
      /* 空血——灰色 */
      drawHeart(ctx, hx, hy, heartSize, '#444');
    }
  }

  /* 顶部居中——分数 */
  ctx.fillStyle = '#fff';
  ctx.font = 'bold 28px "Segoe UI","PingFang SC",sans-serif';
  ctx.textAlign = 'center';
  ctx.shadowColor = 'rgba(0,0,0,0.6)';
  ctx.shadowBlur = 4;
  ctx.fillText(Math.floor(G.score), G.W / 2, 40);
  ctx.shadowBlur = 0;

  /* 右上——速度指示 */
  const speedPct = Math.floor((G.speed - BASE_SPEED) / (MAX_SPEED - BASE_SPEED) * 100);
  ctx.fillStyle = speedPct > 70 ? '#ff6644' : '#aaccff';
  ctx.font = '12px "Segoe UI","PingFang SC",sans-serif';
  ctx.textAlign = 'right';
  ctx.fillText('速度 ' + speedPct + '%', G.W - 14, 28);

  /* DEBUG：障碍物/金币统计 */
  let activeObs = 0, activeCoins = 0;
  for (let i = 0; i < G.obstacles.length; i++) if (G.obstacles[i].active) activeObs++;
  for (let i = 0; i < G.coins.length; i++) if (G.coins[i].active) activeCoins++;
  ctx.fillStyle = '#0f0';
  ctx.font = '11px monospace';
  ctx.textAlign = 'left';
  ctx.fillText('DEBUG obs:' + activeObs + ' coins:' + activeCoins + ' dist:' + Math.floor(G.distance) + 'm spawn:' + Math.floor(G.spawnTimer) + '/' + Math.floor(G.spawnInterval/(G.speed/BASE_SPEED)), 12, G.H - 10);

  /* 道具指示器 */
  const pu = G.player;
  if (pu.activePowerup || pu.hasShield) {
    const puy = 60;
    /* 护盾 */
    if (pu.hasShield) {
      ctx.fillStyle = '#44aaff';
      ctx.font = 'bold 14px "Segoe UI","PingFang SC",sans-serif';
      ctx.textAlign = 'right';
      ctx.fillText('护盾', G.W - 14, puy);
    }
    /* 活动道具计时条 */
    if (pu.activePowerup) {
      const barW = 80, barH = 6;
      const barX = G.W - 14 - barW, barY = puy + 4;
      const pct = pu.powerupTimer / POWERUP_DURATION;
      ctx.fillStyle = 'rgba(255,255,255,0.2)';
      ctx.fillRect(barX, barY, barW, barH);
      const barColor = pu.activePowerup === PUP_MAGNET ? '#ff44ff' :
                       pu.activePowerup === PUP_2X ? '#ffdd00' : '#44aaff';
      ctx.fillStyle = barColor;
      ctx.fillRect(barX, barY, barW * pct, barH);
      /* 标签 */
      const label = pu.activePowerup === PUP_MAGNET ? '磁铁' : '2x分数';
      ctx.fillStyle = '#fff';
      ctx.font = 'bold 12px "Segoe UI","PingFang SC",sans-serif';
      ctx.textAlign = 'right';
      ctx.fillText(label, G.W - 14, puy);
    }
  }
}

function drawHeart(ctx, x, y, size, color) {
  ctx.fillStyle = color;
  ctx.beginPath();
  const s = size / 20;
  ctx.moveTo(x, y + size * 0.35);
  /* 左半 */
  ctx.bezierCurveTo(x, y + size*0.15, x - size*0.45, y - size*0.15, x - size*0.45, y + size*0.25);
  ctx.bezierCurveTo(x - size*0.45, y + size*0.6, x, y + size*0.8, x, y + size);
  /* 右半 */
  ctx.bezierCurveTo(x, y + size*0.8, x + size*0.45, y + size*0.6, x + size*0.45, y + size*0.25);
  ctx.bezierCurveTo(x + size*0.45, y - size*0.15, x, y + size*0.15, x, y + size*0.35);
  ctx.fill();
}

/* =========================== 界面 =========================== */
function drawStartScreen(ctx) {
  /* 半透明遮罩 */
  ctx.fillStyle = 'rgba(0,0,0,0.55)';
  ctx.fillRect(0, 0, G.W, G.H);

  /* 标题 */
  ctx.fillStyle = '#fff';
  ctx.font = 'bold 48px "Segoe UI","PingFang SC",sans-serif';
  ctx.textAlign = 'center';
  ctx.shadowColor = '#e94560';
  ctx.shadowBlur = 20;
  ctx.fillText('轨道跑者', G.W/2, G.H * 0.3);
  ctx.shadowBlur = 0;

  ctx.fillStyle = '#ffcc00';
  ctx.font = 'bold 18px "Segoe UI","PingFang SC",sans-serif';
  ctx.fillText('RAIL RUNNER', G.W/2, G.H * 0.3 + 40);

  /* 操作说明 */
  ctx.fillStyle = '#ddd';
  ctx.font = '16px "Segoe UI","PingFang SC",sans-serif';
  const instructions = [
    '← →  切换轨道',
    '↑  跳跃  |  ↓  滑铲',
    '空格键  开始 / 重来',
  ];
  instructions.forEach((txt, i) => {
    ctx.fillText(txt, G.W/2, G.H * 0.55 + i * 28);
  });

  /* 最高分 */
  if (G.highScore > 0) {
    ctx.fillStyle = '#ffdd44';
    ctx.font = 'bold 20px "Segoe UI","PingFang SC",sans-serif';
    ctx.fillText('最高分: ' + G.highScore, G.W/2, G.H * 0.74);
  }

  /* 提示 */
  const alpha = 0.5 + 0.5 * Math.sin(G.frameCount * 0.05);
  ctx.fillStyle = `rgba(255,255,255,${alpha})`;
  ctx.font = '18px "Segoe UI","PingFang SC",sans-serif';
  ctx.fillText('点击屏幕 或 按空格键 开始', G.W/2, G.H * 0.85);
}

function drawDeathScreen(ctx) {
  /* 半透明遮罩 */
  ctx.fillStyle = 'rgba(0,0,0,0.6)';
  ctx.fillRect(0, 0, G.W, G.H);

  /* 得分面板背景 */
  const panelW = G.W * 0.7;
  const panelH = G.H * 0.35;
  const panelX = (G.W - panelW) / 2;
  const panelY = G.H * 0.25;
  ctx.fillStyle = 'rgba(20,20,40,0.9)';
  ctx.strokeStyle = '#e94560';
  ctx.lineWidth = 2;
  roundRect(ctx, panelX, panelY, panelW, panelH, 16);
  ctx.fill();
  ctx.stroke();

  /* 标题 */
  ctx.fillStyle = '#e94560';
  ctx.font = 'bold 28px "Segoe UI","PingFang SC",sans-serif';
  ctx.textAlign = 'center';
  ctx.fillText('游戏结束', G.W/2, panelY + 45);

  /* 本次得分 */
  ctx.fillStyle = '#fff';
  ctx.font = 'bold 24px "Segoe UI","PingFang SC",sans-serif';
  ctx.fillText('得分: ' + Math.floor(G.score), G.W/2, panelY + 80);

  /* 距离 */
  ctx.fillStyle = '#aaa';
  ctx.font = '16px "Segoe UI","PingFang SC",sans-serif';
  ctx.fillText('距离: ' + Math.floor(G.distance) + ' 米', G.W/2, panelY + 108);

  /* 最高分 */
  const isNew = G.score >= G.highScore && G.highScore > 0;
  ctx.fillStyle = isNew ? '#ffdd44' : '#aaa';
  ctx.font = 'bold 18px "Segoe UI","PingFang SC",sans-serif';
  ctx.fillText((isNew ? '🎉 新纪录！' : '最高分: ') + G.highScore, G.W/2, panelY + 135);

  /* 重来提示 */
  const alpha = 0.5 + 0.5 * Math.sin(G.frameCount * 0.06);
  ctx.fillStyle = `rgba(255,255,255,${alpha})`;
  ctx.font = '18px "Segoe UI","PingFang SC",sans-serif';
  ctx.fillText('点击屏幕 或 按空格键 重来', G.W/2, panelY + panelH + 40);
}

function roundRect(ctx, x, y, w, h, r) {
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.lineTo(x + w - r, y);
  ctx.quadraticCurveTo(x + w, y, x + w, y + r);
  ctx.lineTo(x + w, y + h - r);
  ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
  ctx.lineTo(x + r, y + h);
  ctx.quadraticCurveTo(x, y + h, x, y + h - r);
  ctx.lineTo(x, y + r);
  ctx.quadraticCurveTo(x, y, x + r, y);
  ctx.closePath();
}

/* =========================== 游戏主循环 =========================== */
function gameLoop(timestamp) {
  G.deltaTime = timestamp - G.lastTime;
  G.lastTime = timestamp;

  /* FPS 计算 */
  G.frameCount++;
  G.fpsFrameCount++;
  G.fpsTime += G.deltaTime;
  if (G.fpsTime >= 1000) {
    G.fps = G.fpsFrameCount;
    G.fpsFrameCount = 0;
    G.fpsTime = 0;
  }

  processInput();
  update();
  render();
  requestAnimationFrame(gameLoop);
}

/* =========================== 启动 =========================== */
init();
</script>
